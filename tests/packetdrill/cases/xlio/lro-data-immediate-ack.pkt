// An LRO completion containing more than one advertised receive MSS must
// trigger an immediate cumulative ACK. Regression coverage for Redmine #5267303.
// Requires an LRO-capable NIC: two back-to-back 1460-byte wire segments
// must arrive within its aggregation timeout (32 us on dor01).
// QUICKACK and software GRO are disabled in the matching XLIO configuration.
// A 400 ms TCP timer separates a delayed ACK from the 60 ms wire tolerance.
`kernel/defaults.sh`

0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 setsockopt(3, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0
+0 < S 0:0(0) win 65535 <mss 1460,sackOK,nop,nop,nop,wscale 8>
+0 > S. 0:0(0) ack 1 <mss 1460,nop,wscale 8>
+0 < . 1:1(0) ack 1 win 257
+0 accept(3, ..., ...) = 4
+0 close(3) = 0

// Send both segments at the same scripted time to exercise hardware LRO.
+0.050 < . 1:1461(1460) ack 1 win 257
+0 < P. 1461:2921(1460) ack 1 win 257
+0 > . 1:1(0) ack 2921
+0 recv(4, ..., 2920, MSG_WAITALL) = 2920

+0 close(4) = 0
+0 > F. 1:1(0) ack 2921
+0 < F. 2921:2921(0) ack 2 win 257
+0 > . 2:2(0) ack 2922
