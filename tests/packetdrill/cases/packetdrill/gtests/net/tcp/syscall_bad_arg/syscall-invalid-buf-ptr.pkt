// Test kernel behavior with NULL as buffer pointer

`packetdrill/gtests/net/common/defaults.sh`

    0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
   +0 setsockopt(3, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0
   +0 fcntl(3, F_SETFL, O_RDWR|O_NONBLOCK) = 0
   +0 bind(3, ..., ...) = 0
   +0 listen(3, 1) = 0

   +0 < S 0:0(0) win 32792 <mss 1000,sackOK,nop,nop,nop,wscale 10>
   +0 > S. 0:0(0) ack 1 <mss 1460,nop,wscale 8>
  +.2 < . 1:1(0) ack 1 win 514

   +0 accept(3, ..., ...) = 4

// Linux returns EFAULT when a nonzero-length TX call has a NULL buffer.
// XLIO's TCP slow path currently skips an iovec whose base pointer is NULL;
// because it processes no bytes, write(), send(), and sendto() return zero.
// These expectations deliberately record current XLIO behavior. Validating
// the pointer and returning EFAULT would improve Linux/POSIX compatibility.
   +0 write(4, NULL, 1000) = 0
   +0 send(4, NULL, 1000, 0) = 0
   +0 sendto(4, NULL, 1000, 0, ..., ...) = 0

// Keep the remote Packetdrill flow and its kernel-drop rules alive after the
// TX assertions. Without a later packet event, the wire server tears down the
// flow immediately after the handshake; the peer kernel then resets this
// still-open socket before the TX calls can be evaluated. This ACK has no
// payload and is not part of the NULL-buffer behavior under test.
  +.1 < . 1:1(0) ack 1 win 200

// The upstream test also calls read(), recv(), and recvfrom() with a NULL
// destination and nonzero length, expecting EFAULT. XLIO currently reaches
// memcpy() with that NULL destination and crashes with SIGSEGV. Those RX calls
// are intentionally omitted so this passing suite does not crash its runner.
// XLIO should validate RX pointers and return EFAULT before copying.
