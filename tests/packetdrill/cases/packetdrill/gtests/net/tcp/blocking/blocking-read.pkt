// Test for blocking read.
--tolerance_usecs=10000

`packetdrill/gtests/net/common/defaults.sh`

// Establish a connection.
    0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
   +0 setsockopt(3, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0
   +0 bind(3, ..., ...) = 0
   +0 listen(3, 1) = 0

  +.1 < S 0:0(0) win 32792 <mss 1000,nop,wscale 7>
   +0 > S. 0:0(0) ack 1 <mss 1460,nop,wscale 8>
  +.1 < . 1:1(0) ack 1 win 257
   +0 accept(3, ..., ...) = 4

   +0...0.100 read(4, ..., 1000) = 1000
  +.1 < P. 1:1001(1000) ack 1 win 257
   +0 > . 1:1(0) ack 1001

  +.1...0.200 read(4, ..., 1000) = 1000
  +.1 < P. 1001:2001(1000) ack 1 win 257
   +0 > . 1:1(0) ack 2001

  +.1 < . 2001:3001(1000) ack 1 win 257
   +0 > . 1:1(0) ack 3001
   +0 < P. 3001:4001(1000) ack 1 win 257
   +0 > . 1:1(0) ack 4001
   +0...0.000 read(4, ..., 1000) = 1000
   +0...0.000 read(4, ..., 1000) = 1000
