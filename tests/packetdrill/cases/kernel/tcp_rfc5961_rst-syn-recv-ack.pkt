//
// Isolated from tcp_rfc5961_rst-syn-recv.pkt so each scenario runs in a
// fresh XLIO process with an independent Packetdrill sequence mapping.

`kernel/defaults.sh`

// RST sequence validation precedes ACK validation. Linux sends a challenge
// ACK even when the non-exact RST carries an unacceptable ACK value.
   0 socket(..., SOCK_STREAM|SOCK_NONBLOCK, IPPROTO_TCP) = 3
  +0 setsockopt(3, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0
  +0 bind(3, ..., ...) = 0
  +0 listen(3, 1) = 0
  +0 < S 0:0(0) win 1000 <mss 1000,sackOK,nop,nop,nop,wscale 0>
  +0 > S. 0:0(0) ack 1 <...>
  +0 < R. 2:2(0) ack 100 win 1000
// Linux sends a challenge ACK and preserves the request. XLIO sends no
// challenge ACK and destroys the request without validating the RST sequence
// or the unacceptable ACK field.
  +0 < . 1:1(0) ack 1 win 1000
  +0 accept(3, ..., ...) = -1 EAGAIN (Resource temporarily unavailable)
  +0 close(3) = 0
