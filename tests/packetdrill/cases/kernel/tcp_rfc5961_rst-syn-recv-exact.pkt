//
// Isolated from tcp_rfc5961_rst-syn-recv.pkt so each scenario runs in a
// fresh XLIO process with an independent Packetdrill sequence mapping.

`kernel/defaults.sh`

// An exact RST removes the SYN-RECEIVED request socket.
   0 socket(..., SOCK_STREAM|SOCK_NONBLOCK, IPPROTO_TCP) = 3
  +0 setsockopt(3, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0
  +0 bind(3, ..., ...) = 0
  +0 listen(3, 1) = 0
  +0 < S 0:0(0) win 1000 <mss 1000,sackOK,nop,nop,nop,wscale 0>
  +0 > S. 0:0(0) ack 1 <...>
  +0 < R 1:1(0) win 1000

// Linux sends RST when this later ACK targets the now-closed endpoint.
// XLIO removes the request but sends nothing in response. This records
// current XLIO behavior and a closed-endpoint compatibility gap.
 +.1 < . 1:1(0) ack 1 win 1000

  +0 close(3) = 0
